<div class="min-h-screen bg-gray-100 p-10">

  <h1 class="text-5xl font-bold text-center mb-10">
    🏠 Sistema Inmobiliario
  </h1>

  <%= if @mensaje do %>
    <div class="bg-green-200 p-4 rounded mb-8 text-center font-bold">
      <%= @mensaje %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

    <%= for propiedad <- @propiedades do %>

      <div class="bg-white rounded-2xl shadow-xl p-6">

        <h2 class="text-2xl font-bold mb-4">
          Propiedad <%= propiedad.id %>
        </h2>

        <p><b>Tipo:</b> <%= propiedad.tipo %></p>

        <p><b>Modalidad:</b> <%= propiedad.modalidad %></p>

        <p><b>Ubicación:</b> <%= propiedad.ubicacion %></p>

        <p><b>Precio:</b> $<%= propiedad.precio %></p>

        <p><b>Estado:</b> <%= propiedad.estado %></p>

        <p><b>Propietario:</b> <%= propiedad.propietario %></p>

        <div class="flex flex-col gap-3 mt-6">

          <button
            phx-click="comprar"
            phx-value-id={propiedad.id}
            class="bg-green-500 hover:bg-green-700 text-white p-3 rounded-xl"
          >
            Comprar
          </button>

          <button
            phx-click="arrendar"
            phx-value-id={propiedad.id}
            class="bg-blue-500 hover:bg-blue-700 text-white p-3 rounded-xl"
          >
            Arrendar
          </button>

          <button
            phx-click="disponible"
            phx-value-id={propiedad.id}
            class="bg-yellow-500 hover:bg-yellow-700 text-white p-3 rounded-xl"
          >
            Disponible
          </button>

        </div>

      </div>

    <% end %>

  </div>

</div>