<div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">

  <nav class="w-full bg-slate-950/90 border-b border-white/10 px-8 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <.link navigate={"/?usuario=#{@usuario}&rol=#{@rol}"} class="text-white text-xl font-bold">
        🏠 Sistema Inmobiliario
      </.link>

      <div class="flex items-center gap-4">
        <.link navigate={"/?usuario=#{@usuario}&rol=#{@rol}"} class="text-slate-200 hover:text-white transition">
          Inicio
        </.link>

        <.link navigate={"/propiedades?usuario=#{@usuario}&rol=#{@rol}"} class="text-white font-bold">
          Propiedades
        </.link>

        <%= if @rol in ["vendedor", "arrendador"] do %>
          <.link navigate={"/crear-propiedad?usuario=#{@usuario}&rol=#{@rol}"} class="text-slate-200 hover:text-white transition">
            Crear propiedad
          </.link>
        <% end %>

        <.link navigate={"/ranking?usuario=#{@usuario}&rol=#{@rol}"} class="text-slate-200 hover:text-white transition">
          Ranking
        </.link>

        <.link navigate={"/mensajes?usuario=#{@usuario}&rol=#{@rol}"} class="text-slate-200 hover:text-white transition">
          Mensajes
        </.link>

        <.link navigate={"/resultados?usuario=#{@usuario}&rol=#{@rol}"} class="text-slate-200 hover:text-white transition">
          Resultados
        </.link>

        <.link navigate={~p"/login"} class="text-slate-200 hover:text-white transition">
          Cerrar sesión
        </.link>
      </div>
    </div>
  </nav>

  <main class="p-10">
    <h1 class="text-5xl font-bold text-white text-center mb-12">
      <%= if @rol == "cliente" do %>
        Propiedades disponibles
      <% else %>
        Mis propiedades publicadas
      <% end %>
    </h1>

    <%= if @mensaje do %>
      <div class="max-w-3xl mx-auto bg-green-100 text-green-700 p-4 rounded-xl mb-8 text-center font-bold">
        <%= @mensaje %>
      </div>
    <% end %>

    <form phx-change="filtrar" class="max-w-7xl mx-auto bg-white rounded-3xl shadow-2xl p-6 mb-10 text-slate-900">
      <h2 class="text-2xl font-bold mb-5">
        Filtrar propiedades
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
        <div>
          <label class="block font-bold mb-2">Tipo</label>
          <select name="tipo" class="w-full rounded-xl border-2 border-slate-200 p-3">
            <option value="">Todos</option>
            <option value="casa">Casa</option>
            <option value="apartamento">Apartamento</option>
            <option value="oficina">Oficina</option>
            <option value="lote">Lote</option>
          </select>
        </div>

        <div>
          <label class="block font-bold mb-2">Modalidad</label>
          <select name="modalidad" class="w-full rounded-xl border-2 border-slate-200 p-3">
            <option value="">Todas</option>
            <option value="venta">Venta</option>
            <option value="arriendo">Arriendo</option>
          </select>
        </div>

        <div>
          <label class="block font-bold mb-2">Estado</label>
          <select name="estado" class="w-full rounded-xl border-2 border-slate-200 p-3">
            <option value="">Todos</option>
            <option value="disponible">Disponible</option>
            <option value="vendida">Vendida</option>
            <option value="arrendada">Arrendada</option>
            <option value="reservada">Reservada</option>
          </select>
        </div>

        <div>
          <label class="block font-bold mb-2">Ubicación</label>
          <input
            type="text"
            name="ubicacion"
            class="w-full rounded-xl border-2 border-slate-200 p-3"
            placeholder="Ubicación"
          />
        </div>

        <div>
          <label class="block font-bold mb-2">Precio máximo</label>
          <input
            type="number"
            name="precio_max"
            class="w-full rounded-xl border-2 border-slate-200 p-3"
            placeholder="Precio máximo"
          />
        </div>
      </div>
    </form>

    <%= if Enum.empty?(@propiedades_filtradas) do %>
      <div class="max-w-3xl mx-auto bg-white text-slate-900 rounded-3xl p-8 text-center font-bold shadow-2xl">
        No se encontraron propiedades.
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

      <%= for propiedad <- @propiedades_filtradas do %>

        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">

          <div class="bg-blue-600 text-white p-5">
            <h2 class="text-3xl font-bold capitalize">
              <%= propiedad.tipo %>
            </h2>

            <p class="text-blue-100 mt-1 capitalize">
              <%= propiedad.modalidad %>
            </p>
          </div>

          <div class="p-6 space-y-3 text-slate-900">
            <p>
              <span class="font-bold">ID:</span>
              <%= propiedad.id %>
            </p>

            <p>
              <span class="font-bold">Ubicación:</span>
              <%= propiedad.ubicacion %>
            </p>

            <p>
              <span class="font-bold">Precio:</span>
              $<%= propiedad.precio %>
            </p>

            <p>
              <span class="font-bold">Habitaciones:</span>
              <%= propiedad.habitaciones %>
            </p>

            <p>
              <span class="font-bold">Área:</span>
              <%= propiedad.area %> m²
            </p>

            <p>
              <span class="font-bold">Estado:</span>

              <span class={[
                "px-3 py-1 rounded-full text-white text-sm font-semibold",
                propiedad.estado == "disponible" && "bg-green-500",
                propiedad.estado == "reservada" && "bg-yellow-500",
                propiedad.estado == "vendida" && "bg-red-500",
                propiedad.estado == "arrendada" && "bg-blue-500"
              ]}>
                <%= propiedad.estado %>
              </span>
            </p>

            <p>
              <span class="font-bold">Propietario:</span>
              <%= propiedad.propietario %>
            </p>
          </div>

          <%= if @editando_id == propiedad.id do %>
            <div class="mx-6 mb-6 rounded-2xl bg-slate-100 p-5 text-slate-900">
              <h3 class="text-2xl font-bold mb-5">
                Editar propiedad
              </h3>

              <form phx-submit="guardar_edicion" class="space-y-4">
                <div>
                  <label class="block font-bold mb-2">Tipo</label>

                  <select
                    name="tipo"
                    class="w-full rounded-xl border-2 border-slate-300 p-3"
                  >
                    <option value="casa" selected={@form_edicion["tipo"] == "casa"}>Casa</option>
                    <option value="apartamento" selected={@form_edicion["tipo"] == "apartamento"}>Apartamento</option>
                    <option value="oficina" selected={@form_edicion["tipo"] == "oficina"}>Oficina</option>
                    <option value="lote" selected={@form_edicion["tipo"] == "lote"}>Lote</option>
                  </select>
                </div>

                <div>
                  <label class="block font-bold mb-2">Ubicación</label>

                  <input
                    type="text"
                    name="ubicacion"
                    value={@form_edicion["ubicacion"]}
                    class="w-full rounded-xl border-2 border-slate-300 p-3"
                  />
                </div>

                <div>
                  <label class="block font-bold mb-2">Precio</label>

                  <input
                    type="number"
                    name="precio"
                    value={@form_edicion["precio"]}
                    class="w-full rounded-xl border-2 border-slate-300 p-3"
                  />
                </div>

                <div>
                  <label class="block font-bold mb-2">Habitaciones</label>

                  <input
                    type="number"
                    name="habitaciones"
                    value={@form_edicion["habitaciones"]}
                    class="w-full rounded-xl border-2 border-slate-300 p-3"
                  />
                </div>

                <div>
                  <label class="block font-bold mb-2">Área m²</label>

                  <input
                    type="number"
                    step="0.1"
                    name="area"
                    value={@form_edicion["area"]}
                    class="w-full rounded-xl border-2 border-slate-300 p-3"
                  />
                </div>

                <div class="flex gap-3 pt-3">
                  <button
                    class="flex-1 rounded-xl bg-green-600 hover:bg-green-700 text-white py-3 font-bold transition"
                  >
                    Guardar cambios
                  </button>

                  <button
                    type="button"
                    phx-click="cancelar_edicion"
                    class="flex-1 rounded-xl bg-slate-500 hover:bg-slate-600 text-white py-3 font-bold transition"
                  >
                    Cancelar
                  </button>
                </div>
              </form>
            </div>
          <% end %>

          <div class="p-6 flex flex-col gap-3">

            <%= if @rol == "cliente" and propiedad.estado == "disponible" and propiedad.modalidad == "venta" do %>
              <button
                phx-click="comprar"
                phx-value-id={propiedad.id}
                class="w-full bg-red-500 hover:bg-red-600 text-white py-3 rounded-xl font-bold transition"
              >
                Comprar
              </button>
            <% end %>

            <%= if @rol == "cliente" and propiedad.estado == "disponible" and propiedad.modalidad == "arriendo" do %>
              <button
                phx-click="arrendar"
                phx-value-id={propiedad.id}
                class="w-full bg-blue-500 hover:bg-blue-600 text-white py-3 rounded-xl font-bold transition"
              >
                Arrendar
              </button>
            <% end %>

            <%= if @rol in ["vendedor", "arrendador"] and propiedad.propietario == @usuario do %>
              <button
                phx-click="editar"
                phx-value-id={propiedad.id}
                class="w-full bg-purple-600 hover:bg-purple-700 text-white py-3 rounded-xl font-bold transition"
              >
                Editar propiedad
              </button>

              <button
                phx-click="disponible"
                phx-value-id={propiedad.id}
                class="w-full bg-yellow-500 hover:bg-yellow-600 text-white py-3 rounded-xl font-bold transition"
              >
                Marcar disponible
              </button>
            <% end %>

          </div>

        </div>

      <% end %>

    </div>
  </main>

</div>