<div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 p-10">

  <div class="max-w-2xl mx-auto bg-white rounded-3xl shadow-2xl p-10">

    <h1 class="text-4xl font-extrabold text-center text-purple-700 mb-8">
      🏠 Publicar Propiedad
    </h1>

    <form phx-submit="guardar" class="space-y-6">

      <div>
        <label class="block text-lg font-bold mb-2">
          Título
        </label>

        <input
          type="text"
          name="titulo"
          class="w-full border-2 border-purple-300 rounded-xl p-4"
          placeholder="Casa moderna..."
        />
      </div>

      <div>
        <label class="block text-lg font-bold mb-2">
          Ubicación
        </label>

        <input
          type="text"
          name="ubicacion"
          class="w-full border-2 border-purple-300 rounded-xl p-4"
          placeholder="Medellín..."
        />
      </div>

      <div>
        <label class="block text-lg font-bold mb-2">
          Precio
        </label>

        <input
          type="number"
          name="precio"
          class="w-full border-2 border-purple-300 rounded-xl p-4"
          placeholder="450000000"
        />
      </div>

      <button
        class="w-full bg-gradient-to-r from-purple-600 to-pink-600 text-white py-4 rounded-xl text-xl font-bold hover:scale-105 transition">

        Publicar Propiedad

      </button>

    </form>

    <%= if @mensaje do %>

      <div class="mt-6 bg-green-100 text-green-700 p-4 rounded-xl font-bold">
        <%= @mensaje %>
      </div>

    <% end %>

  </div>

</div>