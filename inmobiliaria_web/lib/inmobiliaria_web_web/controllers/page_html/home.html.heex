      </button>

    </div>

  </section>

  <!-- CARDS -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-8 px-10 pb-20">

    <div class="card bg-white/10 backdrop-blur-lg shadow-2xl">

      <div class="card-body">

        <h2 class="card-title text-2xl">
          🏡 Casas
        </h2>

        <p>
          Explora casas modernas y familiares.
        </p>

      </div>

    </div>

    <div class="card bg-white/10 backdrop-blur-lg shadow-2xl">

      <div class="card-body">

        <h2 class="card-title text-2xl">
          🏢 Apartamentos
        </h2>

        <p>
          Encuentra apartamentos en las mejores zonas.
        </p>

      </div>

    </div>

    <div class="card bg-white/10 backdrop-blur-lg shadow-2xl">

      <div class="card-body">

        <h2 class="card-title text-2xl">
          🌴 Fincas
        </h2>

        <p>
          Vive rodeado de naturaleza y tranquilidad.
        </p>

      </div>

    </div>

