<div class="min-h-screen bg-gradient-to-br from-indigo-900 via-purple-800 to-pink-700 text-white">

  <!-- NAVBAR -->
  <nav class="flex items-center justify-between p-6 bg-black/20 backdrop-blur-md shadow-lg">

    <h1 class="text-3xl font-bold">
      🏠 InmoElite
    </h1>

    <div class="flex gap-4">

      <button class="btn btn-primary rounded-full">
        Iniciar Sesión
      </button>

      <button class="btn btn-secondary rounded-full">
